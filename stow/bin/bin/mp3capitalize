#!/usr/bin/perl
#
use strict;
use warnings;

use Encode qw(decode_utf8 encode_utf8);
use Getopt::Long;
use Unicode::Normalize qw(NFD);

my ($bare_print, $dry_run);
GetOptions(
    'bare-print|bare_print' => \$bare_print,
    'dry-run|dry_run|n'     => \$dry_run,
);

foreach (@ARGV) {
    next unless -f;
    my $orig = $_;

    # deal with unicode conversions
    $_ = decode_utf8($_);
    $_ = NFD($_);           # decompose: é → e + combining accent
    s/\pM//g;               # strip combining marks (the accents)
    # $_ = encode_utf8($_);   # back to bytes... or just:
    s/[^\x00-\x7F]//g;      # nuke anything non-ASCII that survived


    s/\s+/_/g;
    s/\(U\)//g;
    s/\[!\]//g;
    s/[?'()\[\]]//g;
    s/&/_and_/g;
    s/%/_Percent_/g;
    s/[\\:;*?"<>|]/_/g;
    s/(^|_|\b)(\w)/$1\u$2/g;
    s/([^A-Za-z])([IiVv]+)([^A-Za-z])/$1\U$2\E$3/g;
    s/(\.\w+)$/lc($1)/e;
    s/_{2,}/_/g;
    s/\.{2,}/./g;
    s/_+-_+/-/g;
    s/_\././g;
    print "$orig => $_\n" unless $bare_print or $orig eq $_;
    print "$_"            if $bare_print;
    rename $orig, $_ unless $dry_run or $orig eq $_;
}
