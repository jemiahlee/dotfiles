{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ ! -x \"$f\" ] || \"$f\""
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
